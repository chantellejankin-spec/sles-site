---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Contact"
  description="Get in touch with Sierra Leone Engineering Solutions C.S.O. in Freetown about engineering, climate resilience and community development partnerships."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow reveal"><a href={base} style="color:inherit;">&larr; SLES C.S.O.</a></p>
      <h1 class="reveal">Get in Touch</h1>
      <p class="lede reveal">
        For questions about our programmes, partnership proposals or media
        enquiries, reach out using the details below.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card-grid cols-2 reveal">
        <div class="card">
          <div class="card-head">
            <Icon name="message" />
            <h3>Email</h3>
          </div>
          <p>
            <a class="text-link" href="mailto:srrlnngnrngsltnscs@gmail.com">srrlnngnrngsltnscs@gmail.com</a>
          </p>
        </div>
        <div class="card">
          <div class="card-head">
            <Icon name="message" />
            <h3>Phone</h3>
          </div>
          <p><a class="text-link" href="tel:+23230428752">+232 30 428 752</a></p>
        </div>
        <div class="card">
          <div class="card-head">
            <Icon name="pin" />
            <h3>Address</h3>
          </div>
          <p>20 Liverpool Street<br />Freetown, Sierra Leone</p>
        </div>
        <div class="card">
          <div class="card-head">
            <Icon name="user" />
            <h3>Chairman</h3>
          </div>
          <p>Mr Ishmael Faye</p>
        </div>
        <div class="card">
          <div class="card-head">
            <Icon name="award" />
            <h3>Registration</h3>
          </div>
          <p>Reg. No. 101207/2023<br />Freetown City Council Receipt No. 0050673</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

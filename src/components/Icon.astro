  users:
    '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17.5" cy="9.5" r="2.3"/><path d="M15 20c0-2.6 1.9-4.7 4.3-5.2"/>',
  tree: '<path d="M12 2 6 11h3l-4 6h5v5h4v-5h5l-4-6h3z"/>',
  bolt: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/>',
  wave: '<path d="M2 15c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2 2 2 4 2"/><path d="M2 10c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2 2-2 4-2"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 016.5 17H20V4H6.5A2.5 2.5 0 004 6.5v13z"/><path d="M4 19.5V6.5A2.5 2.5 0 016.5 4H20"/>',
  handshake:
    '<path d="M3 11l5-4 4 2 4-2 5 4"/><path d="M8 13l3 3 1-1"/><path d="M12 16l2 2 1-1"/><path d="M3 11v3l4 4"/><path d="M21 11v3l-4 4"/>',
  shield: '<path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3z"/><path d="M9 12l2 2 4-4"/>',

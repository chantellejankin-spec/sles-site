---

<span class={`icon-badge ${variant}`}>
  <svg
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icons[name] ?? ''}
  />
</span>

<style>
  .icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .icon-badge.default {
    background: var(--forest);
    color: var(--sand-pale);
  }

  .icon-badge.inverse {
    background: var(--sand-pale);
    color: var(--forest);
  }

  .icon-badge.plain {
    background: none;
    color: var(--forest);
    width: auto;
    height: auto;
  }
</style>
